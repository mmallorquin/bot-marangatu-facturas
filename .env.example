# Copiá este archivo como .env y completá los valores.
# El archivo .env está en .gitignore: nunca se sube a GitHub.

# Token del bot de Telegram. Lo obtenés hablándole a @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# API key de OpenRouter (https://openrouter.ai/keys). Ponele un límite de crédito.
OPENROUTER_API_KEY=

# Modelo con visión que lee las facturas (opcional). Por defecto: google/gemini-3.1-flash-lite
# Otros probados: deepseek/deepseek-v4.1-flash, anthropic/claude-haiku-4.5
# Para comparar modelos con tus fotos: go run ./cmd/comparar
OPENROUTER_MODEL=

# Cuánto "piensa" el modelo (opcional): none, minimal, low, medium, high.
# Vacío = el valor por defecto del modelo. Más razonamiento = más lento y más caro.
OPENROUTER_REASONING=

# true (por defecto): solo proveedores que no guardan tus facturas (zero data retention).
# Algunos modelos no tienen proveedores así; ponelo en false solo si sabés lo que hacés.
OPENROUTER_ZDR=true

# Archivo SQLite donde se guardan las facturas (opcional). Por defecto: data/facturas.db
# La carpeta data/ está en .gitignore.
DATABASE_PATH=
