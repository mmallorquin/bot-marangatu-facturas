# Copiá este archivo como .env y completá los valores.
# El archivo .env está en .gitignore: nunca se sube a GitHub.

# Token del bot de Telegram. Lo obtenés hablándole a @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# API key de OpenRouter (https://openrouter.ai/keys). Ponele un límite de crédito.
OPENROUTER_API_KEY=

# Modelo con visión que lee las facturas (opcional). Por defecto: deepseek/deepseek-v4.1-flash
# Otros probados: google/gemini-3.1-flash-lite, anthropic/claude-haiku-4.5
OPENROUTER_MODEL=

# true (por defecto): solo proveedores que no guardan tus facturas (zero data retention).
# Algunos modelos no tienen proveedores así; ponelo en false solo si sabés lo que hacés.
OPENROUTER_ZDR=true
